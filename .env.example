# Copy to .env (or export in the shell) to override the defaults of docker-compose.yml.
# All values below are the defaults.

# Host ports
KAFKA_PORT=9092          # Kafka for programs on the host: localhost:9092
FLINK_UI_PORT=8081       # Flink web UI: http://localhost:8081
DASHBOARD_PORT=8000      # dashboard: http://localhost:8000

# Flink job
FLINK_OFFSET=latest      # latest = only what the producer writes after the job started; earliest = whole topic
FLINK_PARALLELISM=2      # 1..4 (the TaskManager has 4 slots, the topics 4 partitions)
FLINK_MAX_OOO_S=120      # watermark bound in event-time seconds; e.g. 30 to see traffic-late-readings fill

# Producer
DATA_START=2026-10-01    # day downloaded into ./data when traffic.csv / links.geojson are missing
SPEEDUP=60               # event-time seconds per wall-clock second (60: 1 h of data per minute, a day in 24 min)
# NY time of day to start at, e.g. START_AT=06:00 (morning rush hour); empty = from midnight
START_AT=
DISORDER_RATIO=0.1       # share of readings sent out of order
MAX_DELAY_S=120          # max event-time delay of such a reading
SEED=42                  # makes the disorder reproducible
LIMIT=0                  # stop after N readings, 0 = all
LOOP=false               # true = replay forever, each round one day later
# true = if traffic-readings already holds the replayed days (an earlier run), replay whole days
# later so event time keeps moving forward; false = replay the same days again
CONTINUE=true

# Dashboard
HISTORY_HOURS=168        # how far back the time bar can travel (event time; 168 = a week)
